# Production environment for deployments/docker-compose.prod.yml.
#
#   cp .env.prod.example .env
#
# `.env` is the file compose reads and is gitignored; this template is the only
# one that is committed, so nothing here is a secret and no real value belongs
# in it. The app validates all of this at boot and refuses to start with a
# required name missing, so a typo fails loudly on the first `up` rather than
# serving a blank contract id.
#
# The dev stack's template is .env.example; this one differs in the three ways
# production has to: a generated database password, a hostname for TLS, and
# contract ids that are not empty.

# ---- secrets ---------------------------------------------------------------
# Used by the `db` service, and interpolated into DATABASE_URL for the API and
# the migration job by the x-database-url anchor in deployments/docker-compose.prod.yml.
# Generate one and keep it: there is no way to recover a Postgres password, and
# changing it later means editing it here, tearing the stack down, and bringing
# it back up (the volume keeps the old credential otherwise):
#
#   openssl rand -hex 24
POSTGRES_USER=sci
POSTGRES_PASSWORD=
POSTGRES_DB=sci_healthcare

# ---- TLS -------------------------------------------------------------------
# The hostname Caddy asks Let's Encrypt for a certificate on. It must already
# resolve to this server, over :80, before the stack starts, or the first
# certificate request fails and the site stays unreachable until it succeeds.
SITE_ADDRESS=

# ---- what may call this API ------------------------------------------------
# Required, and stricter here than anywhere else: with NODE_ENV=production the
# app rejects `*` outright and refuses to boot, so the frontend's exact origin
# has to be listed. Comma-separate more than one.
CORS_ORIGIN=

# ---- stellar network -------------------------------------------------------
# The app checks NETWORK_PASSPHRASE against STELLAR_NETWORK at startup and
# exits on a mismatch, so these two are one decision written twice.
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# A second endpoint keeps indexing through an RPC outage: repeated failures
# rotate to the next one. Comma-separated; this wins over SOROBAN_RPC_URL.
# SOROBAN_RPC_URLS=https://soroban-testnet.stellar.org,https://your-backup-rpc.example
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# For mainnet instead:
# STELLAR_NETWORK=public
# SOROBAN_RPC_URL=https://soroban-rpc.mainnet.stellar.org
# NETWORK_PASSPHRASE="Public Global Stellar Network ; September 2015"

# ---- contract ids ----------------------------------------------------------
# Printed by `scripts/deploy.sh` in the contracts repo; the current testnet
# values are in the README and render.yaml. The three required ones must be
# exactly 56 characters or the app will not start.
REGISTRY_CONTRACT_ID=
VOUCHER_CONTRACT_ID=
RECEIPT_CONTRACT_ID=
# Optional: only used to price things, and skipped entirely when unset.
USDC_CONTRACT_ID=
# Optional: testnet demo faucet. Set to count drips in /stats.
FAUCET_CONTRACT_ID=

# ---- indexer ---------------------------------------------------------------
# The ledger the contracts were deployed at. This is the one value that is
# wrong by default in a hurry: 0 starts at the current tip and silently skips
# all history, and a read model that is missing the past still answers 200.
# Soroban RPC keeps a rolling window of ledgers, so a long-backdated start may
# need an archive or a fresh deployment.
INDEXER_START_LEDGER=0
INDEXER_POLL_MS=5000

# /ready reports degraded once the indexer trails the chain by more ledgers
# than this, so it is the number to raise if a single slow RPC endpoint makes
# a healthy deployment look sick.
READY_MAX_LAG_LEDGERS=120

# ---- logging ---------------------------------------------------------------
LOG_LEVEL=info

# ---- webhooks (optional) ---------------------------------------------------
# Comma-separated endpoints notified of voucher events. Leave both blank to
# disable delivery entirely. Once WEBHOOK_URLS is set the app requires
# WEBHOOK_SECRET and rejects anything under 16 characters, because an unsigned
# event is indistinguishable from a forged one:
#
#   openssl rand -hex 32
WEBHOOK_URLS=
WEBHOOK_SECRET=

# ---- the rest --------------------------------------------------------------
# Everything src/env.ts accepts is fair game here, including the pool and
# statement-timeout bound for Postgres, the SSE limits and the shutdown grace.
# The full list with defaults is the `## Environment` table in the README.
# DATABASE_POOL_SIZE=10
# DATABASE_STATEMENT_TIMEOUT_MS=10000
# SSE_MAX_CONNECTIONS=64
# SHUTDOWN_TIMEOUT_MS=15000
